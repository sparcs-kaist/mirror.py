  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "vite": "^7.3.1"
  },
  "overrides": {
    "dompurify": "^3.4.15"
  }
}
